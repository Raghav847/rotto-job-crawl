PROXY_HOST=pr.oxylabs.io
PROXY_PORT=7777
PROXY_USERNAME=
PROXY_PASSWORD=
# Alternatively set PROXY_URL, including URL-encoded credentials.
# Leave all proxy variables unset for direct access.

# Local Docker Postgres defaults; change before the first volume initialization.
POSTGRES_DB=rotto
POSTGRES_USER=rotto
POSTGRES_PASSWORD=rotto-local
POSTGRES_PORT=55432
# DATABASE_URL overrides the connection derived from these settings.
# Tests create a fresh rotto_test_<uuid> database using this local role.
# TEST_DATABASE_ADMIN_URL optionally supplies a different CREATEDB-capable role.

# Bounded live crawl defaults; raise budgets after verifying extraction accuracy.
CRAWL_SOURCES=linkedin,reed,indeed
CRAWL_QUERIES=software engineer,data engineer
CRAWL_LOCATIONS=United Kingdom
CRAWL_MAX_PAGES=2
CRAWL_DISCOVERY=auto
CRAWL_MAX_DETAILS=20
CRAWL_MAX_REQUESTS=300
CRAWL_MAX_SECONDS=600
CRAWL_REQUEST_DELAY=2
INDEED_MAX_PAGES=1
DETAIL_REFRESH_HOURS=24
# Set PROXY_COST_PER_GB_USD to the actual rate to populate cost estimates.
# CRAWL_SAVE_PAGES=1 saves ignored raw HTML samples for debugging.
# CRAWL_FORCE_REFRESH=1 refreshes stored details immediately for maintenance/review.
# CRAWL_REFRESH_IDS=linkedin:123456789 refreshes selected existing IDs first, within the detail budget.
# CRAWL_DISCOVERY=always rechecks search heads; never drains queues/due refreshes only.
# Indeed defaults to Chromium inside Docker with a fresh sticky session.
# INDEED_FETCH_MODE=http selects HTTP-only access for diagnosis.
# INDEED_RESOURCE_POLICY=baseline restores full frontend loading for comparisons.
# CRAWL_MODE=probe runs the bounded diagnostic instead of the persistence pipeline.
# PROBE_BROWSER=1 selects the browser diagnostic; BROWSER_STICKY=1 pins its exit IP.
